# Configurar archivo de inicio predeterminado
DirectoryIndex index.php default.php

# Forzar HTTPS en producción
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Enrutamiento de las paginas y endpoints de la aplicacion.
    RewriteRule ^admin(?:/.*)?/?$ public/index.php [L,QSA]
    RewriteRule ^api/admin(?:/.*)?/?$ public/index.php [L,QSA]
    RewriteRule ^(trivia|ranking)/?$ public/index.php [L,QSA]
    RewriteRule ^api/(ranking|csrf|trivia/(current|player|submissions))/?$ public/index.php [L,QSA]
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes

# Proteger directorios del sistema y almacenamiento sensible
RedirectMatch 404 /\.git
RedirectMatch 404 /vendor/
RedirectMatch 404 /storage/
RedirectMatch 404 /config/
RedirectMatch 404 /app/

# Proteger archivos sensibles y de configuración
<FilesMatch "^\.env|\.git|composer\.(json|lock)|package\.json|\.htaccess|\.htpasswd">
    Require all denied
</FilesMatch>

# Prevenir acceso a archivos de backup y temporales
<FilesMatch "(\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)|~)$">
    Require all denied
</FilesMatch>